{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/get_batch_diffs.json",
  "title": "RPC get_batch_diffs response",
  "description": "批量 diff（可选 fromTurn/toTurn 范围，按 path 取首尾快照）。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "get_batch_diffs"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "diff": {
                        "type": "string"
                      },
                      "added": {
                        "type": "integer"
                      },
                      "removed": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "path",
                      "diff",
                      "added",
                      "removed"
                    ]
                  }
                },
                "summary": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "files": {
                      "type": "integer"
                    },
                    "added": {
                      "type": "integer"
                    },
                    "removed": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "files",
                    "added",
                    "removed"
                  ]
                }
              },
              "required": [
                "files",
                "summary"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
