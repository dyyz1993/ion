{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/turn_file_diff.json",
  "title": "RPC turn_file_diff response",
  "description": "单轮单文件 diff。params.base: before（默认）/prev/disk。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "turn_file_diff"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "turnId": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "diff": {
                  "type": "string"
                },
                "added": {
                  "type": "integer"
                },
                "removed": {
                  "type": "integer"
                }
              },
              "required": [
                "turnId",
                "path",
                "diff",
                "added",
                "removed"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
