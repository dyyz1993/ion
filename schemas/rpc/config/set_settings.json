{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/set_settings.json",
  "title": "RPC set_settings response",
  "description": "写入单键配置（default_provider/default_model/api_key/base_url）。api_key 的 new_value 脱敏为 '***'。未知 key → data.error。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "set_settings"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "key": {
                  "type": "string"
                },
                "old_value": {},
                "new_value": {},
                "saved": {
                  "const": true
                }
              },
              "required": [
                "key",
                "old_value",
                "new_value",
                "saved"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
