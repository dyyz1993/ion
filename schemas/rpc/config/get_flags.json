{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/get_flags.json",
  "title": "RPC get_flags response",
  "description": "读扩展 flag。无 params.extension → 所有扩展的 flag map（裸对象）；带 extension → {extension, flags}。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "get_flags"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "extension": {
                  "type": "string"
                },
                "flags": {
                  "type": "object"
                }
              },
              "required": [
                "extension",
                "flags"
              ]
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
