{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/get_file_history.json",
  "title": "RPC get_file_history response",
  "description": "单文件快照历史。缺 filePath → data.error。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "get_file_history"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "path": {
                  "type": "string"
                },
                "history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "turnId": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "added",
                          "deleted",
                          "modified",
                          "unchanged"
                        ]
                      },
                      "toolCallId": {
                        "type": "string"
                      },
                      "tool": {
                        "type": "string"
                      },
                      "hash": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "turnId",
                      "action",
                      "toolCallId",
                      "tool",
                      "hash"
                    ]
                  }
                },
                "count": {
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "history",
                "count"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
