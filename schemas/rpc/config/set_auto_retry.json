{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/set_auto_retry.json",
  "title": "RPC set_auto_retry response",
  "description": "开关 LLM 自动重试。enabled=false 时 max_retries 恒 0。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "set_auto_retry"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_retries": {
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "max_retries"
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
