{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/restore_files.json",
  "title": "RPC restore_files response",
  "description": "代码回滚到指定 turn（tree-hash restore）。缺 toTurn → data.error；file-snapshot 未启用 → data.error。+ FilesRestored 事件。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "restore_files"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "restoredFiles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string"
                      },
                      "fromHash": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "toHash": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path",
                      "action",
                      "reason"
                    ]
                  }
                },
                "restorePoint": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "summary": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "restored": {
                      "type": "integer"
                    },
                    "deleted": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "restored",
                    "deleted",
                    "skipped"
                  ]
                }
              },
              "required": [
                "restoredFiles",
                "restorePoint",
                "summary"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
