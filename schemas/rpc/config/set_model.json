{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/set_model.json",
  "title": "RPC set_model response",
  "description": "切换模型。⚠️ 响应信封 command 字段是 'get_state'（历史怪癖，不是 'set_model'）。同时落 session JSONL model_change + SessionIndex + SettingsChanged 事件。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "get_state"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "model": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "provider"
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
