{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/set_flag.json",
  "title": "RPC set_flag response",
  "description": "写扩展 flag。缺 extension/flag → data.error。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "set_flag"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "extension": {
                  "type": "string"
                },
                "flag": {
                  "type": "string"
                },
                "value": {},
                "set": {
                  "const": true
                }
              },
              "required": [
                "extension",
                "flag",
                "value",
                "set"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
