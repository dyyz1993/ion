{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/permission_list_stored.json",
  "title": "RPC permission_list_stored response",
  "description": "列出已存储决策规则（session + project 两级）。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "permission_list_stored"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "success": {
              "const": true
            },
            "data": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string"
                      },
                      "pattern": {
                        "type": "string"
                      },
                      "decision": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "string"
                      },
                      "provider": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "config",
                          "stored"
                        ]
                      },
                      "createdAt": {
                        "type": [
                          "string",
                          "integer",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "subject",
                      "pattern",
                      "decision",
                      "scope",
                      "provider",
                      "source"
                    ]
                  }
                },
                "count": {
                  "type": "integer"
                }
              },
              "required": [
                "rules",
                "count"
              ]
            }
          },
          "required": [
            "success",
            "data"
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
