{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/review_reject.json",
  "title": "RPC review_reject response",
  "description": "拒绝单文件并回滚到 baseline，注入 <approval_feedback> XML deny 消息进 session JSONL。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "review_reject"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "path": {
                  "type": "string"
                },
                "status": {
                  "const": "rejected"
                },
                "action": {
                  "type": "string"
                },
                "rolledBack": {
                  "const": true
                },
                "denyMessageInjected": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "status",
                "action",
                "rolledBack",
                "denyMessageInjected"
              ]
            },
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
