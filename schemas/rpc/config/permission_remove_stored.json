{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/config/permission_remove_stored.json",
  "title": "RPC permission_remove_stored response",
  "description": "删除某条存储决策（removed = 被删规则对象）。id 不存在 → 信封 success:false。 ION worker RPC 响应信封：{id, type:'response', command, success, data|error}。success=true → data；success=false → error（output_error_response）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "command",
    "success"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "command": {
      "const": "permission_remove_stored"
    },
    "success": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "success": {
              "const": true
            },
            "data": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "status": {
                  "const": "ok"
                },
                "removed": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "subject": {
                      "type": "string"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "decision": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "config",
                        "stored"
                      ]
                    },
                    "createdAt": {
                      "type": [
                        "string",
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "subject",
                    "pattern",
                    "decision",
                    "scope",
                    "provider",
                    "source"
                  ]
                }
              },
              "required": [
                "status",
                "removed"
              ]
            }
          },
          "required": [
            "success",
            "data"
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
