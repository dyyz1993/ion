      ]
    },
    "parentSession": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentType": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "sessionId",
    "userMessages",
    "assistantMessages",
    "toolResults",
    "totalMessages",
    "tokens",
    "cost",
    "lastEntryId",
    "parentSession",
    "parentType"
