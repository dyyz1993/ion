{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/exec/rollback_preview.json",
  "title": "RPC rollback_preview response",
  "description": "兼容存根：恒 data=null（真实回滚预览走 restore_files / turn_file_diff）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "success",
    "command"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "success": {
      "type": "boolean"
    },
    "command": {
      "const": "rollback_preview"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "null",
          "description": "存根：恒 null"
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true
}
