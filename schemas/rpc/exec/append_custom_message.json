{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/exec/append_custom_message.json",
  "title": "RPC append_custom_message response",
  "description": "追加 custom_message 条目（display=true 时进 LLM 上下文与 UI）：customType + content + details。向会话 JSONL 追加一条条目（对齐 AGENTS.md 存储落位原则）。成功恒 {status:'appended'}；落盘走 append_session_entry（host 侧同形）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "success",
    "command"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "success": {
      "type": "boolean"
    },
    "command": {
      "const": "append_custom_message"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": {
              "const": "appended"
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "requestParams": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "description": "扩展类型名（customType）",
          "type": "string"
        },
        "content": {
          "description": "文本内容",
          "type": "string"
        },
        "display": {
          "description": "是否进 UI/LLM（缺省 true）",
          "type": "boolean"
        },
        "details": {
          "description": "附属明细（自由 JSON）"
        }
      }
    }
  }
}
