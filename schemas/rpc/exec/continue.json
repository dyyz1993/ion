{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/rpc/exec/continue.json",
  "title": "RPC continue response",
  "description": "兼容存根：'Continue last session' 无实际操作，恒 data=null。会话续接实际由 CLI --continue/--resume + create_session/spawn 路径承担，不经本命令。",
  "type": "object",
  "required": [
    "id",
    "type",
    "success",
    "command"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "response"
    },
    "success": {
      "type": "boolean"
    },
    "command": {
      "const": "continue"
    }
  },
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "null",
          "description": "存根：恒 null"
        }
      },
      "required": [
        "success",
        "data"
      ]
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "success",
        "error"
      ]
    }
  ],
  "additionalProperties": true,
  "x-quirks": [
    "src/worker_rpc.rs 主分发臂直接 output_response(Null)，无副作用"
  ]
}
