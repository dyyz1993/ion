{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ion.rpc.worker.abort",
  "title": "RPC abort（worker 级）",
  "description": "中断当前 agent 循环。成功 data = null。来源：src/worker_rpc.rs 分发 'abort' 臂（agent.stop()）。",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": true,
      "description": "无参数"
    },
    "data": { "type": "null" },
    "success": {
      "type": "object",
      "properties": {
        "id": {},
        "type": { "const": "response" },
        "command": { "type": "string" },
        "success": { "const": true },
        "data": { "$ref": "#/$defs/data" },
        "session": { "type": "string" }
      },
      "required": ["type", "success", "data"]
    },
    "error": {
      "type": "object",
      "properties": {
        "id": {},
        "type": { "const": "response" },
        "command": { "type": "string" },
        "success": { "const": false },
        "error": { "type": "string", "minLength": 1 },
        "session": { "type": "string" }
      },
      "required": ["type", "success", "error"]
    }
  }
}
