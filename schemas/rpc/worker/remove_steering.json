{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ion.rpc.worker.remove_steering",
  "title": "RPC remove_steering（worker 级）",
  "description": "删除 steering 队列第 index 条。来源：src/worker_rpc.rs 分发 'remove_steering' 臂。",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "index": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "removed": { "type": "boolean" },
        "steering_queue": { "type": "integer", "minimum": 0, "description": "删除后队列剩余长度" }
      },
      "required": ["removed", "steering_queue"]
    },
    "success": {
      "type": "object",
      "properties": {
        "id": {},
        "type": { "const": "response" },
        "command": { "type": "string" },
        "success": { "const": true },
        "data": { "$ref": "#/$defs/data" },
        "session": { "type": "string" }
      },
      "required": ["type", "success", "data"]
    },
    "error": {
      "type": "object",
      "properties": {
        "id": {},
        "type": { "const": "response" },
        "command": { "type": "string" },
        "success": { "const": false },
        "error": { "type": "string", "minLength": 1 },
        "session": { "type": "string" }
      },
      "required": ["type", "success", "error"]
    }
  }
}
