{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ion.dev/schemas/rpc/subscribe/subscribe_overview.json",
  "title": "subscribe_overview — 全局概览流",
  "description": "ack 携带 initial 快照，之后每次 worker 状态变化推一条 {type:overview_snapshot} 帧（bin/ion.rs accept 循环 subscribe_overview 分支 + worker_registry.rs get_overview/broadcast_overview）。ack 不是普通 response 信封——它复用 response 外壳但 data 里带 stream=overview；本连接之后不再响应命令，转为纯下行流。",
  "type": "object",
  "properties": {
    "request": {
      "type": "object",
      "required": ["id", "method"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "method": { "const": "subscribe_overview" }
      }
    },
    "ack": {
      "type": "object",
      "required": ["type", "id", "success", "data"],
      "properties": {
        "type": { "const": "response" },
        "id": { "type": ["string", "integer", "null"] },
        "success": { "const": true },
        "data": {
          "type": "object",
          "required": ["stream", "initial"],
          "properties": {
            "stream": { "const": "overview" },
            "initial": {
              "description": "初始 overview 载荷，形状同 events/overview.json（本文件自包含，不做跨文件 $ref）"
            }
          }
        }
      }
    },
    "pushFrame": {
      "description": "后续推送帧，形状见 events/overview_snapshot.json",
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "const": "overview_snapshot" },
        "data": { "type": "object" }
      }
    }
  }
}
